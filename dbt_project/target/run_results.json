ilver_jisdor_rates\")\n        ) AS min_date,\n        GREATEST(\n            (SELECT MAX(trade_date) FROM \"macro_dw\".\"analytics\".\"silver_gold_prices\"),\n            (SELECT MAX(trade_date) FROM \"macro_dw\".\"analytics\".\"silver_dxy_index\"),\n            (SELECT MAX(trade_date) FROM \"macro_dw\".\"analytics\".\"silver_jisdor_rates\")\n        ) AS max_date\n),\n\ndate_spine AS (\n    SELECT\n        generate_series(min_date, max_date, INTERVAL '1 day')::DATE AS date_id\n    FROM date_bounds\n),\n\njisdor_active_dates AS (\n    SELECT DISTINCT trade_date\n    FROM \"macro_dw\".\"analytics\".\"silver_jisdor_rates\"\n)\n\nSELECT\n    d.date_id,\n    EXTRACT(YEAR FROM d.date_id)::INT AS year,\n    EXTRACT(QUARTER FROM d.date_id)::INT AS quarter,\n    EXTRACT(MONTH FROM d.date_id)::INT AS month,\n    TRIM(TO_CHAR(d.date_id, 'Day'))::VARCHAR(10) AS day_name,\n    (EXTRACT(ISODOW FROM d.date_id) IN (6, 7))::BOOLEAN AS is_weekend,\n    (\n        EXTRACT(ISODOW FROM d.date_id) NOT IN (6, 7)\n        AND j.trade_date IS NULL\n    )::BOOLEAN AS is_bi_holiday\nFROM date_spine d\nLEFT JOIN jisdor_active_dates j\n    ON d.date_id = j.trade_date\nORDER BY d.date_id", "relation_name": "\"macro_dw\".\"analytics\".\"dim_date\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-20T07:57:54.253361Z", "completed_at": "2026-11-20T07:57:54.292013Z"}, {"name": "execute", "started_at": "2026-11-20T07:57:54.430634Z", "completed_at": "2026-11-20T07:57:54.889603Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.6748712062835693, "adapter_response": {"_message": "CREATE VIEW", "code": "CREATE VIEW", "rows_affected": -1}, "message": "CREATE VIEW", "failures": null, "unique_id": "model.macro_gold_elt.dim_market_regime", "compiled": true, "compiled_code": "SELECT \n    regime_id,\n    regime_label,\n    risk_level,\n    action_recommendation\nFROM \"macro_dw\".\"analytics_gold\".\"mapping_regime\"", "re